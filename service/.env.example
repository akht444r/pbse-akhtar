PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/court_booking
LOG_LEVEL=debug
# Origin of the browser client (localhost:5173 is already allowed by default)
CLIENT_ORIGIN=
# Session 4 OIDC identity configuration — these defaults match `npm run idp`
OIDC_ISSUER=https://auth.campus-court.local
OIDC_JWKS_URI=http://127.0.0.1:9999/jwks.json
OIDC_AUDIENCE=campus-court-api
