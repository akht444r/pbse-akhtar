PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
LOG_LEVEL=debug
# Session 4 OIDC Identity Configuration
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_AUDIENCE=

# Origin the browser app is served from, no trailing slash (CORS allow-list). Needed when deployed.
CLIENT_ORIGIN=

# dev-idp.js only: the private signing key as a one-line JWK. Never commit it. Keeps tokens valid across restarts.
IDP_PRIVATE_JWK=